@model FUNewsManagementSystem.Web.ViewModels.NewsListViewModel

@{
    ViewData["Title"] = "Latest News";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Latest News</h2>
</div>

<!-- Search -->
<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Search by title, content, category..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Keyword))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Keyword))
{
    <div class="alert alert-info">
        Found <strong>@Model.TotalItems</strong> result(s) for "<strong>@Model.Keyword</strong>"
    </div>
}

@if (Model.NewsList == null || !Model.NewsList.Any())
{
    <div class="alert alert-warning text-center py-5">
        <h5>No active news found.</h5>
        <p class="mb-0">Please try another keyword or check back later.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model.NewsList)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Headline</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            <span class="badge bg-info text-dark">@item.CategoryName</span>
                            @if (item.CreatedDate.HasValue)
                            {
                                <small class="ms-2">@item.CreatedDate.Value.ToString("dd/MM/yyyy")</small>
                            }
                        </h6>

                        <p class="card-text flex-grow-1">
                            @(string.IsNullOrEmpty(item.NewsContent)
                                ? ""
                                : (item.NewsContent.Length > 120
                                    ? item.NewsContent.Substring(0, 120) + "..."
                                    : item.NewsContent))
                        </p>

                        @if (item.Tags != null && item.Tags.Any())
                        {
                            <div class="mb-2">
                                @foreach (var tag in item.Tags.Take(3))
                                {
                                    <span class="badge bg-secondary me-1">@tag.TagName</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-action="Details" asp-route-id="@item.NewsArticleID" class="btn btn-sm btn-outline-primary w-100">
                            Read more →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="News pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-keyword="@Model.Keyword">Previous</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-keyword="@Model.Keyword">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-keyword="@Model.Keyword">Next</a>
                </li>
            </ul>
        </nav>
    }
}