@model FUNewsManagementSystem.Web.ViewModels.NewsManagementViewModel
@{
    ViewData["Title"] = "News Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>News Management</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">+ Create News</button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Search news..." /></div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Search</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
</form>

<table class="table table-bordered table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Headline</th>
            <th>Category</th>
            <th>Status</th>
            <th>Created</th>
            <th style="width:150px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.NewsList)
        {
            <tr>
                <td>@item.NewsArticleID</td>
                <td>@item.Headline</td>
                <td>@item.CategoryName</td>
                <td>@(item.NewsStatus == true ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))</td>
                <td>@(item.CreatedDate?.ToString("dd/MM/yyyy"))</td>
                <td>
                    <button class="btn btn-sm btn-warning btn-edit"
                            data-id="@item.NewsArticleID"
                            data-title="@item.NewsTitle"
                            data-headline="@item.Headline"
                            data-content="@item.NewsContent"
                            data-source="@item.NewsSource"
                            data-category="@item.CategoryID"
                            data-status="@(item.NewsStatus == true ? "true" : "false")"
                            data-tags="@(item.Tags != null ? string.Join(",", item.Tags.Select(t => t.TagID)) : "")">
                        Edit
                    </button>
                    <button class="btn btn-sm btn-danger btn-delete" data-id="@item.NewsArticleID" data-title="@item.Headline">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="Create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">Create News</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 mb-3"><label class="form-label">News ID</label><input name="NewsArticleID" class="form-control" required maxlength="20" /></div>
                    <div class="col-md-8 mb-3"><label class="form-label">Title</label><input name="NewsTitle" class="form-control" maxlength="400" /></div>
                </div>
                <div class="mb-3"><label class="form-label">Headline</label><input name="Headline" class="form-control" required maxlength="150" /></div>
                <div class="mb-3"><label class="form-label">Content</label><textarea name="NewsContent" class="form-control" rows="4" maxlength="4000"></textarea></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Source</label><input name="NewsSource" class="form-control" maxlength="400" /></div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category</label>
                        <select name="CategoryID" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.CategoryID">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tags</label>
                    <select name="TagIds" class="form-select" multiple size="5">
                        @foreach (var t in Model.Tags)
                        {
                            <option value="@t.TagID">@t.TagName</option>
                        }
                    </select>
                    <small class="text-muted">Hold Ctrl to select multiple</small>
                </div>
                <div class="form-check mb-3"><input type="checkbox" name="NewsStatus" value="true" class="form-check-input" checked /><label class="form-check-label">Active</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="Edit" method="post" class="modal-content" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editId" />
            <div class="modal-header"><h5 class="modal-title">Edit News</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Title</label><input name="NewsTitle" id="editTitle" class="form-control" maxlength="400" /></div>
                <div class="mb-3"><label class="form-label">Headline</label><input name="Headline" id="editHeadline" class="form-control" required maxlength="150" /></div>
                <div class="mb-3"><label class="form-label">Content</label><textarea name="NewsContent" id="editContent" class="form-control" rows="4" maxlength="4000"></textarea></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Source</label><input name="NewsSource" id="editSource" class="form-control" maxlength="400" /></div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category</label>
                        <select name="CategoryID" id="editCategory" class="form-select" required>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.CategoryID">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tags</label>
                    <select name="TagIds" id="editTags" class="form-select" multiple size="5">
                        @foreach (var t in Model.Tags)
                        {
                            <option value="@t.TagID">@t.TagName</option>
                        }
                    </select>
                </div>
                <div class="form-check mb-3"><input type="checkbox" name="NewsStatus" id="editStatus" value="true" class="form-check-input" /><label class="form-check-label">Active</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning">Update</button>
            </div>
        </form>
    </div>
</div>

<form asp-action="Delete" method="post" id="deleteForm">@Html.AntiForgeryToken()<input type="hidden" name="id" id="deleteId" /></form>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('editId').value = this.dataset.id;
                document.getElementById('editTitle').value = this.dataset.title || '';
                document.getElementById('editHeadline').value = this.dataset.headline || '';
                document.getElementById('editContent').value = this.dataset.content || '';
                document.getElementById('editSource').value = this.dataset.source || '';
                document.getElementById('editCategory').value = this.dataset.category || '';
                document.getElementById('editStatus').checked = this.dataset.status === 'true';

                // Tags
                const selectedTags = (this.dataset.tags || '').split(',');
                const tagSelect = document.getElementById('editTags');
                for (let opt of tagSelect.options) {
                    opt.selected = selectedTags.includes(opt.value);
                }
                new bootstrap.Modal(document.getElementById('editModal')).show();
            });
        });
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function () {
                if (confirm('Delete news "' + this.dataset.title + '"?')) {
                    document.getElementById('deleteId').value = this.dataset.id;
                    document.getElementById('deleteForm').submit();
                }
            });
        });
    </script>
}